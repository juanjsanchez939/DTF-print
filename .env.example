# Variables del docker compose (MongoDB de desarrollo).
# Copiá este archivo a `.env` y completá los valores: `.env` NO se sube a git.

# Usuario root de MongoDB.
MONGO_USERNAME=dtfadmin

# Contraseña root. Generá una al azar, por ejemplo:
#   openssl rand -hex 16
MONGO_PASSWORD=

# Base que usa la app.
MONGO_DATABASE=dtf_print

# Puerto publicado y en qué interfaz (127.0.0.1 = solo local).
MONGO_PORT=27017
BIND_IP=127.0.0.1
